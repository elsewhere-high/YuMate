# YuMate 本地演示模板（复制到仓库根目录 .env）。
# 该模板默认使用 Fake LLM/ASR、Mock 工具和本地 Compose 基础设施，不需要云端 key。

DATABASE_URL="postgresql://yumate:yumate@localhost:55433/yumate"
YUMATE_GATEWAY_URL="http://localhost:8790"
GATEWAY_PORT=8790
AGENT_RUNTIME_PORT=8791
AGENT_RUNTIME_URL="http://localhost:8791"

YUMATE_LLM=fake
YUMATE_ASR=fake
YUMATE_TTS=off
YUMATE_TOOLS=mock
YUMATE_DEMO_TOKEN="demo-token"
YUMATE_ADMIN_TOKEN="admin-token"
YUMATE_OPS_TOKEN="ops-token"
YUMATE_CONFIG_MASTER_KEY=""

MOCK_DEALER_PORT=8792
MOCK_DEALER_URL="http://localhost:8792"
MOCK_CABIN_PORT=8793
MOCK_CABIN_URL="http://localhost:8793"

REDIS_URL="redis://localhost:56379"
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY_ID=yumate
S3_SECRET_ACCESS_KEY=yumate-secret
S3_BUCKET=yumate-attachments

MEM0_VECTOR_PROVIDER=pgvector
MEM0_COLLECTION=yumate_memories
MEM0_DATABASE_URL=""
MEM0_EMBEDDING_BASE_URL="http://localhost:11434"
MEM0_EMBEDDING_MODEL=nomic-embed-text
MEM0_EMBEDDING_DIMS=768

RAGFLOW_BASE_URL=""
RAGFLOW_API_KEY=""
RAGFLOW_DATASET_VEHICLE_MANUALS=""
RAGFLOW_DATASET_REPAIR_KB=""
RAGFLOW_DATASET_CAR_CATALOG=""
