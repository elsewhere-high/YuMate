# YuMate 外部依赖模板（复制到仓库根目录 .env 后按需填写）。
# 也可以先从 .env.demo.example 开始，再覆盖下列真实依赖配置；不要提交 .env。

DATABASE_URL="postgresql://yumate:yumate@localhost:55433/yumate"
YUMATE_GATEWAY_URL="http://localhost:8790"
GATEWAY_PORT=8790
AGENT_RUNTIME_PORT=8791
AGENT_RUNTIME_URL="http://localhost:8791"
YUMATE_CONFIG_MASTER_KEY=""
YUMATE_ADMIN_TOKEN="admin-token"
YUMATE_OPS_TOKEN="ops-token"
YUMATE_DEMO_TOKEN="demo-token"
YUMATE_TOOLS=real
YUMATE_ASR=fake
YUMATE_TTS=off
REDIS_URL="redis://localhost:56379"
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY_ID=yumate
S3_SECRET_ACCESS_KEY=yumate-secret
S3_BUCKET=yumate-attachments

YUMATE_LLM=direct
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_ASR_MODEL="doubao-seed-2-0-mini-260428"

BYTEDANCE_TTS_API_KEY=""
BYTEDANCE_TTS_RESOURCE_ID="seed-tts-2.0"
BYTEDANCE_TTS_SPEAKER="zh_female_vv_uranus_bigtts"

RAGFLOW_BASE_URL=""
RAGFLOW_API_KEY=""
RAGFLOW_DATASET_VEHICLE_MANUALS=""
RAGFLOW_DATASET_REPAIR_KB=""
RAGFLOW_DATASET_CAR_CATALOG=""

AMAP_SERVER_KEY=""
AMAP_JS_KEY=""
AMAP_JS_SECURITY_CODE=""

GUARD_PROVIDER=aliyun
ALIYUN_GUARD_ENDPOINT="https://green-cip.cn-shanghai.aliyuncs.com"
Aliyun_AccessKey_ID=""
Aliyun_AccessKey_Secret=""
ALIYUN_GUARD_PRO=true
ALIYUN_GUARD_TIMEOUT_MS=5000

# GUARD_PROVIDER=openai-compat 时使用
GUARD_MODEL=qwen3guard-gen
GUARD_BASE_URL=""
GUARD_API_KEY=""
GUARD_TIMEOUT_MS=10000
